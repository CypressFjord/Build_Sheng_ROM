#Xiaomi Pad 6S Pro 12.4 Prot
#超清HDR
persist.sys.support_ultra_hdr=true
#超分辨率增强
debug.config.media.video.ais.support=true
#声音视效
ro.vendor.audio.sfx.audiovisual=true
#快充加速
persist.vendor.accelerate.charge=true
#高精度定位
persist.vendor.gnss.hpLocSetUI=1
#扬声器清理
ro.vendor.audio.clean_speaker=true
#游戏三倍速
debug.game.video.speed=true
debug.game.video.support=true
#游戏音频特效增强
ro.vendor.audio.game.effect=true
ro.vendor.audio.game_enhance=true
#停用游戏的默认帧速率
debug.graphics.game_default_frame_rate.disabled=true
#桌面过渡动画
persist.sys.hyper_transition_v=2
persist.sys.hyper_transition=true
#桌面回调动画
ro.miui.shell_anim_enable_fcb=true
#开启平滑圆角
persist.sys.support_view_smoothcorner=true
persist.sys.support_window_smoothcorner=true
#系统界面wm.shell窗口管理器冷启动遮罩
persist.sys.transition_rt.enable=true
persist.sys.transition_beginSchedThreads.enable=true
#高级材质
persist.sys.computility.cpulevel=6
persist.sys.computility.gpulevel=6
persist.sys.computility.version=2025
persist.sys.background_blur_version=2
persist.sys.advanced_visual_release=4
persist.sys.add_blurnoise_supported=true
persist.sys.background_blur_supported=true
persist.sys.background_blur_status_default=true
ro.launcher.blur.appLaunch=1
ro.sf.blurs_are_expensive=false
debug.sysui.display_notification_shadow=1
persist.sys.trim_rendernode.enable=true
#aptX
persist.vendor.qcom.bluetooth.aptxadaptiver2_2_support=true
#mi_sw_sync适配改善因画面渲染不同步导致的丢帧卡顿问题
debug.sf.mi_asynchronous_re.enable=true
#dm映射
debug.sf.enable_transaction_tracing=false
persist.miui.extm.dm_opt.enable=true
persist.miui.extm.daily_flush_count_adj=1
#FPS
ro.vendor.display.idle_default_fps=60
persist.vendor.disable_idle_fps.threshold=60
ro.vendor.display.primary_idle_refresh_rate=60,1:10
#补全刷新率档位
persist.sys.smartpower.limit.normal.max.refresh.rate.enable=true
persist.sys.smartpower.limit.normal.max.refresh.rate.support=144
persist.sys.smartpower.limit.max.refresh.rate=144
#核心分配
persist.sys.miui_animator_sched.bigcores=3-6
persist.sys.miui_animator_sched.big_prime_cores=3-7
persist.vendor.display.miui.composer_boost=4-7
persist.sys.miui.sf_cores=3-7
ro.miui.affinity.sfui=3-7
ro.miui.affinity.sfre=3-7
ro.miui.affinity.sfuireset=0-6
persist.sys.miui_animator_sched.sched_threads=0
#dex2oat
persist.miui.dexopt.first_use=true
dalvik.vm.enable_pr_dexopt=true
dalvik.vm.boot-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.background-dex2oat-cpu-set=0,1,2,3,4,5,6,7
#Bootloader
ro.boot.flash.locked=1
ro.boot.verifiedbootstate=green
ro.secureboot.lockstate=locked
ro.boot.vbmeta.device_state=locked
ro.boot.vbmeta.digest=3234c28d825b3a1623d1983204c91fd8adc9c73e8a5f504d58fcf061ce3b210a
ro.boot.vbmeta.avb_version=1.0
ro.boot.vbmeta.hash_alg=sha256
ro.boot.vbmeta.size=4096
#Log
persist.logd.limit=OFF
persist.logd.size=65536
persist.logd.size.crash=1M
persist.logd.size.radio=1M
persist.logd.size.system=1M
log.tag.stats_log=OFF
ro.logd.size=64K
ro.logd.size.stats=64K
vendor.bluetooth.startbtlogger=false
persist.sys.offlinelog.kernel=false
sys.miui.ndcd=off
ro.kernel.android.checkjni=0
ro.kernel.checkjni=0
persist.wpa_supplicant.debug=false
persist.sys.offlinelog.logcat=false
persist.sys.offlinelog.logcatkernel=false
persist.sys.sysrqOnAnr_D_state=false 
persist.sys.wifi_track=false 
persist.vendor.wifienhancelog=0 
service.offlinelog.bootloader=false
persist.logd.diag.tcpdump=0
persist.sys.qseelogd=0
persist.sys.ssr.enable_debug=0
persist.vendor.sys.rawdump_copy=0
vendor.bluetooth.startbtlogger=0
persist.iorapd.log.verbose=false